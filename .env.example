# Copy to .env.local for local development.

# --- Server-side secret (never NEXT_PUBLIC) ---
ADMIN_PASSWORD=change-me
# Optional: where gifts.json is stored. Defaults to ./data. On Cloud Run this is the mounted bucket (/data).
# DATA_DIR=./data

# --- Public settings, inlined at build time (safe to show on the website) ---
NEXT_PUBLIC_CHURCH_EMAIL=wlabesamis@gmail.com
NEXT_PUBLIC_GOAL=12000000
NEXT_PUBLIC_BASE_RAISED=2700000
# Payment methods: all four are always listed. GCash, Maya and Bank transfer show the value set here;
# if one is empty (or still the XXXX placeholder) donors are told to email the church for the details.
# Format for all three: "Label: value · Label: value" (separate parts with " · "). Edit the account names freely.
# GCash/Maya also accept just a number (account name then defaults to the church).
NEXT_PUBLIC_GCASH_NUMBER="GCash Number: +639228656711 · Account name: Wilson L Abesamis"
NEXT_PUBLIC_MAYA_NUMBER="Maya Number: +639228656711 · Account name: Wilson L Abesamis"
NEXT_PUBLIC_BANK_DETAILS="Bank: Security Bank · Account name: Lean Rose C Cabral · Account no.: 0000077655600"
